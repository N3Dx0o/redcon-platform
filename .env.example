# REDCON OFFENCE Platform — environment variables
# Copy to .env and fill in real values. Do NOT commit .env.

FLASK_ENV=production

# Required secrets — generate with: openssl rand -hex 32
FLASK_SECRET_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
SCANNER_SECRET_KEY=

# Security
FORCE_HTTPS_COOKIES=true
ENABLE_HSTS=true

# JWT lifetimes (seconds)
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Upload limits
MAX_UPLOAD_BYTES=52428800
MAX_ZIP_FILES=1000
MAX_ZIP_UNZIPPED_BYTES=524288000

# Scanner admin bootstrap
SCANNER_ADMIN_EMAIL=
SCANNER_ADMIN_PASSWORD=

# SMTP (notifications)
SMTP_USERNAME=
SMTP_PASSWORD=
